# Copy to backend/.env. Never use the old application's database URL here.
DATABASE_URL=postgresql+psycopg://focustube:focustube@localhost:5433/focustube_fastapi
FRONTEND_ORIGIN=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
SESSION_DAYS=7
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=
SUPADATA_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
RAG_ENABLED=false
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
